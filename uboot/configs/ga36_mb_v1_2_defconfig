# GA36-MB V1.2 (R36S) — U-Boot 2025.07 defconfig for Allwinner A33.
#
# Base: upstream A33-OLinuXino_defconfig (2025.07), adjusted to the frozen
# hardware spec (output/sys_config.fex, output/hardware-report.md):
#   dcdc1=3300mV (VCC-3V3/MMC), dcdc2=1100mV (VCC-CPU), dcdc3=1260mV (VCC-SYS),
#   dcdc5=1350mV (VCC-DRAM)
# Debug console = UART2 (PB00/PB01) via stdout-path in the board DTS.
#
# Bring-up revision:
#   * CONFIG_GA36_BACKLIGHT_BEACON enables the serial-free boot checkpoints:
#     the LCD backlight (LED1 on PH00) blinks 2 = SPL DRAM OK, 3 = U-Boot
#     proper board_init(), 4 = misc_init_r(), fast blink = failure. See
#     patches/uboot/0009 and docs/STATUS.md (Beacon protocol).
#   * MIPI DSI video output is NOT enabled: the raw-register JD9366 driver
#     experiment was reverted. Re-enable only after the vendor lcd.ko/boot0
#     timings are extracted and validated on silicon.
#   * DRAM forced to the factory values (CLK=552, ZQ=63351, ODT, TPR from
#     the stock boot0) — the configuration that produces the 2-blink beacon.

CONFIG_ARM=y
CONFIG_ARCH_SUNXI=y
CONFIG_DEFAULT_DEVICE_TREE="sun8i-a33-ga36-mb-v1.2"
CONFIG_SPL=y
CONFIG_MACH_SUN8I_A33=y
CONFIG_DRAM_CLK=552
CONFIG_DRAM_ZQ=63351
CONFIG_DRAM_ODT_EN=y
CONFIG_GA36_BACKLIGHT_BEACON=y
CONFIG_AXP_GPIO=y
CONFIG_AXP_DCDC1_VOLT=3300
CONFIG_REGULATOR_AXP_DRIVEVBUS=y
CONFIG_REGULATOR_AXP_USB_POWER=y
CONFIG_USB_MUSB_HOST=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_EXT2=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_MMC=y
CONFIG_CMD_USB=y
CONFIG_VIDEO=y
CONFIG_DM_VIDEO=y
CONFIG_VIDEO_LOGO=y
CONFIG_VIDCONSOLE=y
CONFIG_SYS_WHITE_ON_BLACK=y
# CONFIG_VIDEO_SUNXI is not set
CONFIG_BOOTCOMMAND="echo == GA36 U-Boot ==; load mmc 0:1 0x41900000 /boot/boot.scr; source 0x41900000"
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x50
# The sunxi default DATA_PART_OFFSET=0x10 shifts the SPL's U-Boot read from
# LBA 0x50 to 0x60, but with-spl.bin places U-Boot at file 0x8000 (LBA 0x50
# once written at LBA 16). The offset is for eMMC hardware-boot partitions,
# not SD cards, so force it to 0 (see docs/STATUS.md).
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_DATA_PART_OFFSET=0
CONFIG_SYS_SUNXI_UART=2
# CONFIG_DEBUG_UART is not set
# CONFIG_SPL_DISPLAY_PRINT is not set
CONFIG_SPL_SERIAL=y
CONFIG_SPL_SYS_MALLOC=y
# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
