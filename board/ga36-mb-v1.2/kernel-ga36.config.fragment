# Kernel config fragment — merged on top of sunxi_defconfig (v6.12).
# Route A: boots from the STOCK sunxi bootloader via an Android boot image
# (kernel + appended DTB), so the cmdline is FORCED here (the stock
# bootloader's own bootargs are ignored). Root is the ext4 partition inside
# MBR P1 at sector 3383336 (mmcblk0p1), the factory "UDISK" slot.
#
# The merged result is canonicalized with `make savedefconfig` into
# board/ga36-mb-v1.2/linux-ga36.config (the stored, reproducible config).

CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_CMDLINE="console=tty0 root=/dev/mmcblk0p1 rootfstype=ext4 rootwait rw init=/sbin/init coherent_pool=4m boot_type=1 config_size=0 earlycon=uart,mmio32,0x01c28800 loglevel=8 initcall_debug=1 panic=10"
CONFIG_CMDLINE_FORCE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_GPIO_SYSFS=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_SUN6I_DSI=y
CONFIG_DRM_PANEL_JD9366=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_POWER_RESET_GPIO=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_PWM_SUN4I=y
CONFIG_SND_SUN8I_CODEC=y
CONFIG_DRM_SUN6I_MIPI_DSI=y
CONFIG_COMMON_CLK_DEBUGFS=y
CONFIG_DRM_LIMA=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_SUN8I_THERMAL=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR_AXP20X=y
