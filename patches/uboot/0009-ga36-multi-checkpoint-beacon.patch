diff --git a/board/sunxi/board.c b/board/sunxi/board.c
index ac9cefc..ed23e10 100644
--- a/board/sunxi/board.c
+++ b/board/sunxi/board.c
@@ -54,6 +54,84 @@
 
 DECLARE_GLOBAL_DATA_PTR;
 
+#ifdef CONFIG_GA36_BACKLIGHT_BEACON
+#define GA36_PIO_PH_BASE (SUNXI_PIO_BASE + SUNXI_GPIO_H * SUNXI_PINCTRL_BANK_SIZE)
+#define GA36_BEACON_MS 200
+
+static void ga36_beacon_set(int on)
+{
+	u32 val = readl(GA36_PIO_PH_BASE + 0x10);
+
+	if (on)
+		val |= (1U << 0);
+	else
+		val &= ~(1U << 0);
+	writel(val, GA36_PIO_PH_BASE + 0x10);
+}
+
+static void ga36_beacon_hw_init(void)
+{
+	/* PH00 as GPIO output: drives the LCD backlight-enable pin. */
+	clrsetbits_le32(GA36_PIO_PH_BASE, 0xf, SUNXI_GPIO_OUTPUT);
+	/*
+	 * Backlight rail (AXP22x DC1SW). SPL only: in U-Boot proper the
+	 * regulator is already on, and touching the PMIC bus again can hang.
+	 */
+#ifdef CONFIG_XPL_BUILD
+	pmic_bus_setbits(0x12, (1U << 7));
+#endif
+}
+
+/*
+ * Serial-free boot checkpoints, signalled by blinking the backlight
+ * (LED1, PH00). Each pattern is n blinks of GA36_BEACON_MS followed by a
+ * long pause so consecutive patterns are easy to tell apart by eye.
+ *
+ *   2 = SPL: DRAM init OK
+ *   3 = SPL: SoC init done, about to load U-Boot from SD
+ *   4 = SPL: U-Boot loaded from SD, about to jump to U-Boot proper
+ *   5 = U-Boot proper: board_init() (SPL -> U-Boot transition)
+ *   6 = U-Boot proper: misc_init_r() (init sequence complete)
+ *   7 = reserved: DSI PHY / TCON clock up
+ *   8 = reserved: panel reset deasserted
+ *   9 = reserved: DCS init sequence sent
+ *   fast continuous blink = reached the step but failed
+ */
+static void ga36_beacon(int n)
+{
+	int i;
+
+	ga36_beacon_hw_init();
+	for (i = 0; i < n; i++) {
+		ga36_beacon_set(1);
+		mdelay(GA36_BEACON_MS);
+		ga36_beacon_set(0);
+		mdelay(GA36_BEACON_MS);
+	}
+	mdelay(2000);
+}
+
+static void __maybe_unused ga36_beacon_error(void)
+{
+	ga36_beacon_hw_init();
+	for (;;) {
+		ga36_beacon_set(1);
+		mdelay(100);
+		ga36_beacon_set(0);
+		mdelay(100);
+	}
+}
+#else
+static inline void ga36_beacon(int n) { (void)n; }
+static inline void ga36_beacon_error(void) {}
+#endif
+
+void spl_board_prepare_for_boot(void)
+{
+	/* Checkpoint 4: SPL done, U-Boot loaded from SD, about to jump. */
+	ga36_beacon(4);
+}
+
 void i2c_init_board(void)
 {
 #ifdef CONFIG_I2C0_ENABLE
