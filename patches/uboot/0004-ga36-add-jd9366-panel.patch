From: GA36 FW <ga36@localhost>
Subject: [PATCH] 0004 ga36 add jd9366 DSI panel driver

Add a panel driver for the JD9366 8" 640x480 MIPI DSI panel.
This driver includes the DCS init sequence and handles the
MIPI DSI command transmission.

---

 drivers/video/panel/Kconfig | 11 +++
 drivers/video/panel/Makefile  |  1 +
 drivers/video/panel/jd9366.c  | 213 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 225 insertions(+)
 create mode 100644 drivers/video/panel/jd9366.c

diff --git a/drivers/video/panel/Kconfig b/drivers/video/panel/Kconfig
index xxxxxxx..yyyyyyy 100644
--- a/drivers/video/panel/Kconfig
+++ b/drivers/video/panel/Kconfig
@@ -1,6 +1,17 @@
 # SPDX-License-Identifier: GPL-2.0+
 
 menuconfig PANEL
 	bool "Panel support"
+	depends on CONFIG_VIDEO_MIPI_DSI
+
+if PANEL
+
+config PANEL_JD9366
+	bool "JD9366 8\" 640x480 MIPI DSI panel"
+	help
+	  Support for the JD9366 8 inch 640x480 MIPI DSI panel
+	  (LP079X01 variant, 2 lanes, RGB888).
+
+endif
 
 config PANEL_HX8238D
 	bool "HX8238D panel"
 	depends on PANEL
diff --git a/drivers/video/panel/Makefile b/drivers/video/panel/Makefile
index xxxxxxx..yyyyyyy 100644
--- a/drivers/video/panel/Makefile
+++ b/drivers/video/panel/Makefile
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0+
 
 obj-$(CONFIG_PANEL_HX8238D) += hx8238d.o
+obj-$(CONFIG_PANEL_JD9366) += jd9366.o
 
diff --git a/drivers/video/panel/jd9366.c b/drivers/video/panel/jd9366.c
new file mode 100644
index 0000000..xxxxxxx
--- /dev/null
+++ b/drivers/video/panel/jd9366.c
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * JD9366 8" 640x480 MIPI DSI Panel Driver
+ *
+ * Based on the vendor lcd.ko (LP079X01 patch -> jd9366_8inch)
+ * DCS sequence extracted via scripts/fw/helpers/lcd_dcs_extract.py
+ */
+
+#include <mipi_dsi.h>
+#include <panel.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <asm/io.h>
+
+#include <video/jd9366_init.h>
+
+struct jd9366_priv {
+	struct mipi_dsi_device *dsi;
+};
+
+static int jd9366_dcs_write(struct mipi_dsi_device *dsi,
+			    u8 cmd, u8 count, const u8 *para)
+{
+	int ret;
+
+	if (count == 0) {
+		ret = mipi_dsi_dcs_write(dsi, cmd, NULL, 0);
+	} else {
+		ret = mipi_dsi_dcs_write(dsi, cmd, para, count);
+	}
+
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+static int jd9366_enable(struct udevice *dev)
+{
+	struct jd9366_priv *priv = dev_get_priv(dev);
+	struct mipi_dsi_device *dsi = priv->dsi;
+	int i, ret;
+
+	debug("JD9366: enabling panel\n");
+
+	for (i = 0; i < ARRAY_SIZE(jd9366_init); i++) {
+		const struct jd9366_dcs_entry *entry = &jd9366_init[i];
+
+		if (entry->count == JD9366_DCS_DELAY) {
+			mdelay(entry->para[0]);
+			continue;
+		}
+
+		if (entry->count == 0) {
+			ret = jd9366_dcs_write(dsi, entry->cmd, 0, NULL);
+		} else {
+			ret = jd9366_dcs_write(dsi, entry->cmd, entry->count, entry->para);
+		}
+
+		if (ret) {
+			debug("JD9366: DCS cmd 0x%02x failed: %d\n", entry->cmd, ret);
+			return ret;
+		}
+
+		debug("JD9366: sent cmd 0x%02x count=%d\n", entry->cmd, entry->count);
+	}
+
+	debug("JD9366: panel enabled\n");
+	return 0;
+}
+
+static int jd9366_get_display_timing(struct udevice *dev,
+				     struct display_timing *timing)
+{
+	timing->pixelclock.typ = 30000000; /* 30 MHz */
+	timing->hactive.typ = 640;
+	timing->vactive.typ = 480;
+	timing->hfront_porch.typ = 40;
+	timing->hback_porch.typ = 60;
+	timing->hsync_len.typ = 20;
+	timing->vfront_porch.typ = 8;
+	timing->vback_porch.typ = 10;
+	timing->vsync_len.typ = 2;
+	timing->flags = DISPLAY_FLAGS_DE_ONLY_MODE | DISPLAY_FLAGS_PIXDATA_POSEDGE;
+
+	return 0;
+}
+
+static int jd9366_probe(struct udevice *dev)
+{
+	struct jd9366_priv *priv = dev_get_priv(dev);
+	struct udevice *dsi_dev;
+	int ret;
+
+	/* Get the MIPI DSI device */
+	ret = uclass_get_device_by_phandle(UCLASS_MIPI_DSI, dev,
+					   "dsi-host", &dsi_dev);
+	if (ret) {
+		debug("JD9366: failed to get DSI host: %d\n", ret);
+		return ret;
+	}
+
+	priv->dsi = dev_get_priv(dsi_dev);
+	if (!priv->dsi) {
+		debug("JD9366: failed to get DSI device\n");
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static const struct panel_ops jd9366_ops = {
+	.enable = jd9366_enable,
+	.get_display_timing = jd9366_get_display_timing,
+};
+
+static const struct udevice_id jd9366_ids[] = {
+	{ .compatible = "jd9366,8inch" },
+	{ }
+};
+
+U_BOOT_DRIVER(jd9366_panel) = {
+	.name = "jd9366_panel",
+	.id = UCLASS_PANEL,
+	.of_match = jd9366_ids,
+	.ops = &jd9366_ops,
+	.probe = jd9366_probe,
+	.priv_auto = sizeof(struct jd9366_priv),
+};