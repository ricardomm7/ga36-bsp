From: GA36 FW <ga36@localhost>
Subject: [PATCH] 0011 ga36 add MIPI DSI clock and reset definitions

Add clock and reset IDs for Allwinner A33 MIPI DSI controller
and D-PHY to the sun6i CCU bindings.

The A33 uses:
- CLK_BUS_MIPI_DSI (bus clock) - AHB gate1 bit 31
- CLK_MIPI_DSI (module clock) - mipi_dsi_clk_cfg register
- RST_BUS_MIPI_DSI (reset) - AHB reset2 bit 0

---

 arch/arm/include/asm/arch-sunxi/clock_sun6i.h | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/arm/include/asm/arch-sunxi/clock_sun6i.h b/arch/arm/include/asm/arch-sunxi/clock_sun6i.h
index xxxxxxx..yyyyyyy 100644
--- a/arch/arm/include/asm/arch-sunxi/clock_sun6i.h
+++ b/arch/arm/include/asm/arch-sunxi/clock_sun6i.h
@@ -180,6 +180,15 @@ struct sunxi_ccm_reg {
 #define CCM_MIPI_CSI_CLK_CFG		/* 0x16c MIPI CSI clock control */
 u32 reserved17[4];
 u32 iep_drc0_clk_cfg;		/* 0x180 IEP DRC0 module clock */
+
+/* MIPI DSI clock and reset definitions */
+#define CLK_BUS_MIPI_DSI		31	/* AHB gate1 bit 31 */
+#define CLK_MIPI_DSI			0x168	/* mipi_dsi_clk_cfg register */
+#define RST_BUS_MIPI_DSI		0	/* AHB reset2 bit 0 */
+
 u32 mbus0_clk_cfg;		/* 0x15c MBUS0 module clock */
 u32 mbus1_clk_cfg;		/* 0x160 MBUS1 module clock */
@@ -590,6 +599,12 @@
 #define AHB_RESET_OFFSET_LVDS		0
 
 /* AHB reset2 offsets */
+#define AHB_RESET_OFFSET_MIPI_DSI	0
+
+/* Clock source selections for MIPI DSI */
+#define CCM_MIPI_DSI_CTRL_PLL3		(0 << 24)
+#define CCM_MIPI_DSI_CTRL_PLL7		(1 << 24)
+#define CCM_MIPI_DSI_CTRL_PLL3_2X	(2 << 24)
+#define CCM_MIPI_DSI_CTRL_PLL7_2X	(3 << 24)
+#define CCM_MIPI_DSI_CTRL_MIPI_PLL	(4 << 24)
+#define CCM_MIPI_DSI_CTRL_GATE		(1 << 31)
+
 #endif /* _SUNXI_CLOCK_SUN6I_H */