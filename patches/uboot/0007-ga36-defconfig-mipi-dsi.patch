From: GA36 FW <ga36@localhost>
Subject: [PATCH] 0007 ga36 defconfig enable video MIPI DSI

Update GA36-MB V1.2 defconfig to enable MIPI DSI video stack.

---

 configs/ga36_mb_v1_2_defconfig | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/configs/ga36_mb_v1_2_defconfig b/configs/ga36_mb_v1_2_defconfig
index xxxxxxx..yyyyyyy 100644
--- a/configs/ga36_mb_v1_2_defconfig
+++ b/configs/ga36_mb_v1_2_defconfig
@@ -10,13 +10,32 @@
 #   * CONFIG_VIDEO removed: the stock RGB/LCD video path cannot drive the
 #     MIPI-DSI (JD9366) panel and only risks a silent hang.
 
 CONFIG_ARM=y
 CONFIG_ARCH_SUNXI=y
 CONFIG_DEFAULT_DEVICE_TREE="sun8i-a33-ga36-mb-v1.2"
 CONFIG_SPL=y
 CONFIG_MACH_SUN8I_A33=y
 CONFIG_DRAM_CLK=432
 CONFIG_DRAM_ZQ=15291
 CONFIG_DRAM_ODT_EN=y
 CONFIG_GA36_BACKLIGHT_BEACON=y
+CONFIG_GA36_MIPI_DSI=y
+CONFIG_SUN8I_A33_MIPI_DSI=y
+CONFIG_PHY_SUN8I_A33_MIPI_DPHY=y
 # CONFIG_VIDEO_SUNXI is not set
 CONFIG_AXP_GPIO=y
 CONFIG_AXP_DCDC1_VOLT=3300
 CONFIG_AXP_DCDC2_VOLT=1100
 CONFIG_AXP_DCDC3_VOLT=1260
 CONFIG_AXP_DCDC5_VOLT=1350
 CONFIG_REGULATOR_AXP_DRIVEVBUS=y
 CONFIG_REGULATOR_AXP_USB_POWER=y
 CONFIG_USB_MUSB_HOST=y
 CONFIG_CMD_BOOTZ=y
 CONFIG_CMD_EXT2=y
 CONFIG_CMD_EXT4=y
 CONFIG_CMD_FAT=y
 CONFIG_CMD_GPIO=y
 CONFIG_CMD_MMC=y
 CONFIG_CMD_USB=y
+CONFIG_VIDEO_MIPI_DSI=y
+CONFIG_VIDEO=y
+CONFIG_VIDEO_SUNXI=y
+CONFIG_DISPLAY=y
+CONFIG_PANEL=y
+CONFIG_PANEL_JD9366=y
+CONFIG_VIDEO_LOGO=y
+CONFIG_VIDCONSOLE=y
+CONFIG_VIDEO_BMP=y
 CONFIG_BOOTCOMMAND="echo == GA36 U-Boot ==; load mmc 0:1 0x41900000 /boot/boot.scr; source 0x41900000"
 CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x50
 CONFIG_SYS_SUNXI_UART=2
 # CONFIG_DEBUG_UART is not set
 # CONFIG_SPL_DISPLAY_PRINT is not set
 CONFIG_SPL_SERIAL=y
 CONFIG_SPL_SYS_MALLOC=y
 # CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
 # CONFIG_TOOLS_KWBIMAGE is not set
 # CONFIG_TOOLS_LIBCRYPTO is not set
 # CONFIG_TOOLS_MKEFICAPSULE is not set