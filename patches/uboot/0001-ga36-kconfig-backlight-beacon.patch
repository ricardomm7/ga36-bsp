From: GA36 FW <ga36@localhost>
Subject: [PATCH] 0001 ga36 kconfig backlight beacon

Generated local patch for GA36-MB V1.2 (R36S) bring-up.

---
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -462,6 +462,14 @@
 
 endchoice
 
+config GA36_BACKLIGHT_BEACON
+	bool "GA36-MB backlight beacon (serial-free bring-up)"
+	help
+	  Serial-free bring-up aid for the GA36-MB V1.2 (R36S): the LCD
+	  backlight (LED1 on PH00) blinks a checkpoint pattern as boot
+	  progresses (2 = SPL DRAM OK, 3 = U-Boot proper board_init,
+	  4 = misc_init_r, fast blink = failure), readable without a UART.
+
 # The sun8i SoCs share a lot, this helps to avoid a lot of "if A23 || A33"
 config MACH_SUN8I
 	bool
