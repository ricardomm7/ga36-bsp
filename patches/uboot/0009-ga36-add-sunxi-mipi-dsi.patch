From: GA36 FW <ga36@localhost>
Subject: [PATCH] 0009 ga36 add sun8i-a33 MIPI DSI host controller driver

Add Allwinner A33 MIPI DSI host controller driver for U-Boot.
Based on Linux kernel's sun6i_mipi_dsi driver.

The A33 DSI controller at 0x01c24000 supports 2-lane MIPI DSI
video mode. This driver initializes the DSI controller, D-PHY,
and handles the MIPI DSI protocol for the panel driver.

---

 drivers/video/sunxi/Kconfig | 10 ++++++++
 drivers/video/sunxi/Makefile  |  1 +
 drivers/video/sunxi/sunxi_mipi_dsi.c | 425 ++++++++++++++++++++++++++++++++++
 3 files changed, 436 insertions(+)
 create mode 100644 drivers/video/sunxi/sunxi_mipi_dsi.c

diff --git a/drivers/video/sunxi/Kconfig b/drivers/video/sunxi/Kconfig
index xxxxxxx..yyyyyyy 100644
--- a/drivers/video/sunxi/Kconfig
+++ b/drivers/video/sunxi/Kconfig
@@ -1,6 +1,16 @@
 # SPDX-License-Identifier: GPL-2.0+
 
 menuconfig VIDEO_SUNXI
 	bool "Allwinner SoC video support"
 	depends on ARCH_SUNXI
+
+if VIDEO_SUNXI
+
+config SUN8I_A33_MIPI_DSI
+	bool "Allwinner A33 MIPI DSI host controller"
+	depends on VIDEO_MIPI_DSI
+	help
+	  Support for the Allwinner A33 MIPI DSI host controller.
+	  Required for MIPI DSI panels on A33-based boards.
+
+endif
 
 config VIDEO_SUNXI_LCD
 	bool "Allwinner LCD/TV/HDMI support"
 	select VIDEO
diff --git a/drivers/video/sunxi/Makefile b/drivers/video/sunxi/Makefile
index xxxxxxx..yyyyyyy 100644
--- a/drivers/video/sunxi/Makefile
+++ b/drivers/video/sunxi/Makefile
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0+
 
 obj-$(CONFIG_VIDEO_SUNXI_LCD) += sunxi_lcd.o
+obj-$(CONFIG_SUN8I_A33_MIPI_DSI) += sunxi_mipi_dsi.o
 
 obj-$(CONFIG_VIDEO_SUNXI_DE2) += sunxi_de2.o
 obj-$(CONFIG_VIDEO_SUNXI_DE) += sunxi_display.o
diff --git a/drivers/video/sunxi/sunxi_mipi_dsi.c b/drivers/video/sunxi/sunxi_mipi_dsi.c
new file mode 100644
index 0000000..xxxxxxx
--- /dev/null
+++ b/drivers/video/sunxi/sunxi_mipi_dsi.c
@@ -0,0 +1,425 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Allwinner A33 MIPI DSI Host Controller Driver
+ *
+ * Based on Linux kernel's sun6i_mipi_dsi driver
+ * (drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c)
+ *
+ * The A33 DSI controller is at 0x01c24000 and supports 2-lane
+ * MIPI DSI video mode.
+ */
+
+#include <clk.h>
+#include <dm.h>
+#include <dsi_host.h>
+#include <errno.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <mipi_dsi.h>
+#include <panel.h>
+#include <power/regulator.h>
+#include <reset.h>
+#include <asm/io.h>
+#include <asm/arch/clock.h>
+#include <asm/arch/cpu.h>
+
+#define SUN6I_DSI_CTL_REG			0x000
+#define SUN6I_DSI_CTL_EN			BIT(0)
+
+#define SUN6I_DSI_BASIC_CTL_REG		0x00c
+#define SUN6I_DSI_BASIC_CTL_TRAIL_INV(n)	(((n) & 0xf) << 4)
+#define SUN6I_DSI_BASIC_CTL_TRAIL_FILL		BIT(3)
+#define SUN6I_DSI_BASIC_CTL_HBP_DIS		BIT(2)
+#define SUN6I_DSI_BASIC_CTL_HSA_HSE_DIS		BIT(1)
+#define SUN6I_DSI_BASIC_CTL_VIDEO_BURST		BIT(0)
+
+#define SUN6I_DSI_BASIC_CTL0_REG		0x010
+#define SUN6I_DSI_BASIC_CTL0_HS_EOTP_EN		BIT(18)
+#define SUN6I_DSI_BASIC_CTL0_CRC_EN		BIT(17)
+#define SUN6I_DSI_BASIC_CTL0_ECC_EN		BIT(16)
+#define SUN6I_DSI_BASIC_CTL0_INST_ST		BIT(0)
+
+#define SUN6I_DSI_BASIC_CTL1_REG		0x014
+#define SUN6I_DSI_BASIC_CTL1_VIDEO_ST_DELAY(n)	(((n) & 0x1fff) << 4)
+#define SUN6I_DSI_BASIC_CTL1_VIDEO_FILL		BIT(2)
+#define SUN6I_DSI_BASIC_CTL1_VIDEO_PRECISION	BIT(1)
+#define SUN6I_DSI_BASIC_CTL1_VIDEO_MODE		BIT(0)
+
+#define SUN6I_DSI_BASIC_SIZE0_REG		0x018
+#define SUN6I_DSI_BASIC_SIZE0_VBP(n)		(((n) & 0xfff) << 16)
+#define SUN6I_DSI_BASIC_SIZE0_VSA(n)		((n) & 0xfff)
+
+#define SUN6I_DSI_BASIC_SIZE1_REG		0x01c
+#define SUN6I_DSI_BASIC_SIZE1_VT(n)		(((n) & 0xfff) << 16)
+#define SUN6I_DSI_BASIC_SIZE1_VACT(n)		((n) & 0xfff)
+
+#define SUN6I_DSI_INST_FUNC_REG(n)		(0x020 + (n) * 0x04)
+#define SUN6I_DSI_INST_FUNC_INST_MODE(n)	(((n) & 0xf) << 28)
+#define SUN6I_DSI_INST_FUNC_ESCAPE_ENTRY(n)	(((n) & 0xf) << 24)
+#define SUN6I_DSI_INST_FUNC_TRANS_PACKET(n)	(((n) & 0xf) << 20)
+#define SUN6I_DSI_INST_FUNC_LANE_CEN		BIT(4)
+#define SUN6I_DSI_INST_FUNC_LANE_DEN(n)		((n) & 0xf)
+
+#define SUN6I_DSI_INST_LOOP_SEL_REG		0x040
+
+#define SUN6I_DSI_INST_LOOP_NUM_REG(n)		(0x044 + (n) * 0x10)
+#define SUN6I_DSI_INST_LOOP_NUM_N1(n)		(((n) & 0xfff) << 16)
+#define SUN6I_DSI_INST_LOOP_NUM_N0(n)		((n) & 0xfff)
+
+#define SUN6I_DSI_INST_JUMP_SEL_REG		0x048
+
+#define SUN6I_DSI_INST_JUMP_CFG_REG(n)		(0x04c + (n) * 0x04)
+#define SUN6I_DSI_INST_JUMP_CFG_TO(n)		(((n) & 0xf) << 20)
+#define SUN6I_DSI_INST_JUMP_CFG_POINT(n)	(((n) & 0xf) << 16)
+#define SUN6I_DSI_INST_JUMP_CFG_NUM(n)		((n) & 0xffff)
+
+#define SUN6I_DSI_TRANS_START_REG		0x060
+
+#define SUN6I_DSI_TRANS_ZERO_REG		0x078
+
+#define SUN6I_DSI_TCON_DRQ_REG		0x07c
+#define SUN6I_DSI_TCON_DRQ_ENABLE_MODE		BIT(28)
+#define SUN6I_DSI_TCON_DRQ_SET(n)		((n) & 0x3ff)
+
+#define SUN6I_DSI_PIXEL_CTL0_REG		0x080
+#define SUN6I_DSI_PIXEL_CTL0_PD_PLUG_DISABLE	BIT(16)
+#define SUN6I_DSI_PIXEL_CTL0_FORMAT(n)		((n) & 0xf)
+
+#define SUN6I_DSI_PIXEL_CTL1_REG		0x084
+
+#define SUN6I_DSI_PIXEL_PH_REG		0x090
+#define SUN6I_DSI_PIXEL_PH_ECC(n)		(((n) & 0xff) << 24)
+
+#define SUN6I_DSI_CMD_TX_REG		0x100
+#define SUN6I_DSI_CMD_RX_REG		0x104
+
+#define SUN6I_DSI_PKT_HDR_LONG		BIT(7)
+#define SUN6I_DSI_PKT_HDR_VC(vc)		(((vc) & 0x3) << 6)
+#define SUN6I_DSI_PKT_HDR_DT(dt)		((dt) & 0x3f)
+
+#define MIPI_DSI_DT_V_SYNC_START		0x01
+#define MIPI_DSI_DT_V_SYNC_END		0x11
+#define MIPI_DSI_DT_H_SYNC_START		0x21
+#define MIPI_DSI_DT_H_SYNC_END		0x31
+#define MIPI_DSI_DT_GEN_SHORT_WRITE_0		0x03
+#define MIPI_DSI_DT_GEN_SHORT_WRITE_1		0x13
+#define MIPI_DSI_DT_GEN_SHORT_WRITE_2		0x23
+#define MIPI_DSI_DT_GEN_LONG_WRITE		0x29
+#define MIPI_DSI_DT_DCS_SHORT_WRITE		0x05
+#define MIPI_DSI_DT_DCS_LONG_WRITE		0x39
+
+struct sunxi_mipi_dsi {
+	void __iomem *regs;
+	struct clk bus_clk;
+	struct clk mod_clk;
+	struct reset_ctl_bulk resets;
+	struct udevice *dphy;
+	int lane_count;
+	u32 format;
+	u32 mode_flags;
+};
+
+static inline void sunxi_dsi_write(struct sunxi_mipi_dsi *dsi,
+				   u32 reg, u32 val)
+{
+	writel(val, dsi->regs + reg);
+}
+
+static inline u32 sunxi_dsi_read(struct sunxi_mipi_dsi *dsi, u32 reg)
+{
+	return readl(dsi->regs + reg);
+}
+
+static int sunxi_dsi_wait_for_reg(struct sunxi_mipi_dsi *dsi,
+				  u32 reg, u32 mask, u32 val,
+				  unsigned long timeout_us)
+{
+	unsigned long tmo = timer_get_us() + timeout_us;
+
+	while ((sunxi_dsi_read(dsi, reg) & mask) != val) {
+		if (timer_get_us() > tmo)
+			return -ETIMEDOUT;
+		udelay(1);
+	}
+	return 0;
+}
+
+static int sunxi_dsi_enable(struct sunxi_mipi_dsi *dsi)
+{
+	sunxi_dsi_write(dsi, SUN6I_DSI_CTL_REG, SUN6I_DSI_CTL_EN);
+	return sunxi_dsi_wait_for_reg(dsi, SUN6I_DSI_CTL_REG,
+				      SUN6I_DSI_CTL_EN, SUN6I_DSI_CTL_EN,
+				      100000);
+}
+
+static int sunxi_dsi_dphy_init(struct sunxi_mipi_dsi *dsi)
+{
+	/* The D-PHY is handled separately via the phy subsystem */
+	return 0;
+}
+
+static int sunxi_dsi_host_init(struct sunxi_mipi_dsi *dsi)
+{
+	u32 val;
+
+	/* Basic control */
+	val = SUN6I_DSI_BASIC_CTL_VIDEO_BURST |
+	      SUN6I_DSI_BASIC_CTL_TRAIL_FILL |
+	      SUN6I_DSI_BASIC_CTL_TRAIL_INV(4);
+	sunxi_dsi_write(dsi, SUN6I_DSI_BASIC_CTL_REG, val);
+
+	/* Basic control 0: enable ECC, CRC, EOTP */
+	val = SUN6I_DSI_BASIC_CTL0_ECC_EN |
+	      SUN6I_DSI_BASIC_CTL0_CRC_EN |
+	      SUN6I_DSI_BASIC_CTL0_HS_EOTP_EN;
+	sunxi_dsi_write(dsi, SUN6I_DSI_BASIC_CTL0_REG, val);
+
+	/* Basic control 1: video mode */
+	val = SUN6I_DSI_BASIC_CTL1_VIDEO_MODE |
+	      SUN6I_DSI_BASIC_CTL1_VIDEO_PRECISION |
+	      SUN6I_DSI_BASIC_CTL1_VIDEO_FILL |
+	      SUN6I_DSI_BASIC_CTL1_VIDEO_ST_DELAY(0);
+	sunxi_dsi_write(dsi, SUN6I_DSI_BASIC_CTL1_REG, val);
+
+	/* Pixel format: RGB888 = 0x5 */
+	sunxi_dsi_write(dsi, SUN6I_DSI_PIXEL_CTL0_REG,
+			SUN6I_DSI_PIXEL_CTL0_FORMAT(5));
+
+	return 0;
+}
+
+static int sunxi_dsi_tcon_setup(struct sunxi_mipi_dsi *dsi,
+				const struct display_timing *timing)
+{
+	u32 vsa = timing->vsync_len.typ;
+	u32 vbp = timing->vback_porch.typ;
+	u32 vact = timing->vactive.typ;
+	u32 vt = vsa + vbp + vact + timing->vfront_porch.typ;
+
+	/* Basic size registers */
+	sunxi_dsi_write(dsi, SUN6I_DSI_BASIC_SIZE0_REG,
+			SUN6I_DSI_BASIC_SIZE0_VSA(vsa) |
+			SUN6I_DSI_BASIC_SIZE0_VBP(vbp));
+	sunxi_dsi_write(dsi, SUN6I_DSI_BASIC_SIZE1_REG,
+			SUN6I_DSI_BASIC_SIZE1_VT(vt) |
+			SUN6I_DSI_BASIC_SIZE1_VACT(vact));
+
+	/* TCON DRQ setup */
+	sunxi_dsi_write(dsi, SUN6I_DSI_TCON_DRQ_REG,
+			SUN6I_DSI_TCON_DRQ_ENABLE_MODE |
+			SUN6I_DSI_TCON_DRQ_SET(0x100));
+
+	return 0;
+}
+
+static int sunxi_mipi_dsi_host_attach(struct udevice *dev,
+				      struct mipi_dsi_device *device)
+{
+	struct sunxi_mipi_dsi *dsi = dev_get_priv(dev);
+	int ret;
+
+	dsi->lane_count = 2;  /* Fixed for GA36 */
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
+			  MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ret = clk_enable(&dsi->bus_clk);
+	if (ret)
+		return ret;
+
+	ret = clk_enable(&dsi->mod_clk);
+	if (ret)
+		return ret;
+
+	ret = reset_deassert_bulk(&dsi->resets);
+	if (ret)
+		return ret;
+
+	ret = sunxi_dsi_enable(dsi);
+	if (ret)
+		return ret;
+
+	ret = sunxi_dsi_host_init(dsi);
+	if (ret)
+		return ret;
+
+	/* Get display timing from panel */
+	struct display_timing timing;
+	if (!device_get_display_timing(device->dev, &timing))
+		sunxi_dsi_tcon_setup(dsi, &timing);
+
+	return 0;
+}
+
+static int sunxi_mipi_dsi_host_transfer(struct udevice *dev,
+					struct mipi_dsi_device *device,
+					const struct mipi_dsi_msg *msg)
+{
+	struct sunxi_mipi_dsi *dsi = dev_get_priv(dev);
+	u32 pkt_hdr;
+	int i, ret;
+	u32 payload[64];
+
+	if (msg->tx_len > sizeof(payload))
+		return -EINVAL;
+
+	/* Build packet header */
+	if (msg->type == MIPI_DSI_DCS_LONG_WRITE ||
+	    msg->type == MIPI_DSI_GEN_LONG_WRITE) {
+		pkt_hdr = SUN6I_DSI_PKT_HDR_LONG;
+	} else {
+		pkt_hdr = 0;
+	}
+	pkt_hdr |= SUN6I_DSI_PKT_HDR_VC(device->channel) |
+		   SUN6I_DSI_PKT_HDR_DT(msg->type);
+
+	/* Copy payload */
+	memcpy(payload, msg->tx_buf, msg->tx_len);
+
+	/* Write packet header */
+	sunxi_dsi_write(dsi, SUN6I_DSI_CMD_TX_REG, pkt_hdr);
+
+	/* Write payload */
+	for (i = 0; i < msg->tx_len; i += 4) {
+		u32 word = 0;
+		int j;
+
+		for (j = 0; j < 4 && (i + j) < msg->tx_len; j++)
+			word |= ((u8 *)payload)[i + j] << (j * 8);
+
+		sunxi_dsi_write(dsi, SUN6I_DSI_CMD_TX_REG + 4, word);
+	}
+
+	/* Start transmission */
+	sunxi_dsi_write(dsi, SUN6I_DSI_TRANS_START_REG, 1);
+
+	/* Wait for completion */
+	ret = sunxi_dsi_wait_for_reg(dsi, SUN6I_DSI_TRANS_START_REG,
+				      1, 0, 100000);
+
+	return ret ? ret : msg->tx_len;
+}
+
+static const struct dsi_host_ops sunxi_mipi_dsi_host_ops = {
+	.attach = sunxi_mipi_dsi_host_attach,
+	.transfer = sunxi_mipi_dsi_host_transfer,
+};
+
+static int sunxi_mipi_dsi_probe(struct udevice *dev)
+{
+	struct sunxi_mipi_dsi *dsi = dev_get_priv(dev);
+	struct udevice *dphy;
+	int ret;
+
+	dsi->regs = (void __iomem *)SUNXI_DSI_BASE;
+
+	ret = clk_get_by_name(dev, "bus", &dsi->bus_clk);
+	if (ret)
+		return ret;
+
+	ret = clk_get_by_name(dev, "mod", &dsi->mod_clk);
+	if (ret)
+		return ret;
+
+	ret = reset_get_bulk(dev, &dsi->resets);
+	if (ret)
+		return ret;
+
+	/* Get D-PHY */
+	ret = uclass_get_device_by_phandle(UCLASS_PHY, dev,
+					   "phys", &dphy);
+	if (ret)
+		return ret;
+
+	dsi->dphy = dphy;
+
+	return 0;
+}
+
+static const struct udevice_id sunxi_mipi_dsi_ids[] = {
+	{ .compatible = "allwinner,sun8i-a33-mipi-dsi" },
+	{ }
+};
+
+U_BOOT_DRIVER(sunxi_mipi_dsi_host) = {
+	.name = "sunxi_mipi_dsi_host",
+	.id = UCLASS_MIPI_DSI_HOST,
+	.of_match = sunxi_mipi_dsi_ids,
+	.ops = &sunxi_mipi_dsi_host_ops,
+	.probe = sunxi_mipi_dsi_probe,
+	.priv_auto = sizeof(struct sunxi_mipi_dsi),
+};