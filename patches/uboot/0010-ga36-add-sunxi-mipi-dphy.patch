From: GA36 FW <ga36@localhost>
Subject: [PATCH] 0010 ga36 add sun8i-a33 MIPI D-PHY driver

Add Allwinner A33 MIPI D-PHY driver for U-Boot.
The D-PHY is at 0x01c24400 and handles the physical layer
for MIPI DSI.

---

 drivers/phy/Kconfig |  7 +++++++
 drivers/phy/Makefile  |  1 +
 drivers/phy/sun8i_a33_mipi_dphy.c | 180 ++++++++++++++++++++++++++
 3 files changed, 188 insertions(+)
 create mode 100644 drivers/phy/sun8i_a33_mipi_dphy.c

diff --git a/drivers/phy/Kconfig b/drivers/phy/Kconfig
index xxxxxxx..yyyyyyy 100644
--- a/drivers/phy/Kconfig
+++ b/drivers/phy/Kconfig
@@ -1,6 +1,13 @@
 # SPDX-License-Identifier: GPL-2.0+
 
 menuconfig PHY
 	bool "PHY support"
+	depends on CONFIG_VIDEO_MIPI_DSI
+
+if PHY
+
+config PHY_SUN8I_A33_MIPI_DPHY
+	bool "Allwinner A33 MIPI D-PHY"
+	help
+	  Support for the Allwinner A33 MIPI D-PHY.
+	  Required for MIPI DSI panels on A33-based boards.
+
+endif
 
 config PHY_GENERIC
 	bool "Generic PHY"
diff --git a/drivers/phy/Makefile b/drivers/phy/Makefile
index xxxxxxx..yyyyyyy 100644
--- a/drivers/phy/Makefile
+++ b/drivers/phy/Makefile
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0+
 
 obj-$(CONFIG_PHY_GENERIC) += generic_phy.o
+obj-$(CONFIG_PHY_SUN8I_A33_MIPI_DPHY) += sun8i_a33_mipi_dphy.o
 
diff --git a/drivers/phy/sun8i_a33_mipi_dphy.c b/drivers/phy/sun8i_a33_mipi_dphy.c
new file mode 100644
index 0000000..xxxxxxx
--- /dev/null
+++ b/drivers/phy/sun8i_a33_mipi_dphy.c
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Allwinner A33 MIPI D-PHY Driver
+ *
+ * Based on Linux kernel's phy-sun4i-mipi-dphy driver
+ * (drivers/phy/allwinner/phy-sun4i-mipi-dphy.c)
+ *
+ * The A33 D-PHY is at 0x01c24400.
+ */
+
+#include <clk.h>
+#include <dm.h>
+#include <errno.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <phy.h>
+#include <power/regulator.h>
+#include <reset.h>
+#include <asm/io.h>
+#include <asm/arch/clock.h>
+
+#define SUN8I_DPHY_CTRL0			0x00
+#define SUN8I_DPHY_CTRL0_ENABLE		BIT(31)
+#define SUN8I_DPHY_CTRL0_LANES(n)		(((n) & 0x3) << 2)
+#define SUN8I_DPHY_CTRL0_CLK_LANE		BIT(1)
+#define SUN8I_DPHY_CTRL0_RESET		BIT(0)
+
+#define SUN8I_DPHY_TIMING0			0x04
+#define SUN8I_DPHY_TIMING1			0x08
+#define SUN8I_DPHY_TIMING2			0x0c
+#define SUN8I_DPHY_TIMING3			0x10
+
+#define SUN8I_DPHY_PLL_CTRL			0x20
+#define SUN8I_DPHY_PLL_CTRL_ENABLE		BIT(31)
+#define SUN8I_DPHY_PLL_CTRL_LOCK		BIT(30)
+#define SUN8I_DPHY_PLL_CTRL_DIV(n)		(((n) & 0x1f) << 8)
+#define SUN8I_DPHY_PLL_CTRL_MUL(n)		(((n) & 0x7f) << 0)
+
+#define SUN8I_DPHY_STATUS			0x30
+#define SUN8I_DPHY_STATUS_PLL_LOCK		BIT(0)
+
+struct sun8i_a33_mipi_dphy {
+	void __iomem *regs;
+	struct clk clk;
+	struct reset_ctl_bulk resets;
+	unsigned int lanes;
+	unsigned long clk_rate;
+};
+
+static inline void dphy_write(struct sun8i_a33_mipi_dphy *dphy,
+			      u32 reg, u32 val)
+{
+	writel(val, dphy->regs + reg);
+}
+
+static inline u32 dphy_read(struct sun8i_a33_mipi_dphy *dphy, u32 reg)
+{
+	return readl(dphy->regs + reg);
+}
+
+static int sun8i_a33_mipi_dphy_init(struct phy *phy)
+{
+	struct sun8i_a33_mipi_dphy *dphy = dev_get_priv(phy->dev);
+	u32 val;
+	int ret;
+
+	ret = clk_enable(&dphy->clk);
+	if (ret)
+		return ret;
+
+	ret = reset_deassert_bulk(&dphy->resets);
+	if (ret)
+		return ret;
+
+	/* Reset D-PHY */
+	dphy_write(dphy, SUN8I_DPHY_CTRL0, SUN8I_DPHY_CTRL0_RESET);
+	udelay(10);
+	dphy_write(dphy, SUN8I_DPHY_CTRL0, 0);
+	udelay(10);
+
+	/* Configure PLL for 360 MHz/lane (720 Mbps/lane) */
+	/* With 24 MHz reference clock: PLL = 24 * MUL / DIV */
+	/* Target: 360 MHz = 24 * MUL / DIV -> MUL/DIV = 15 */
+	/* Use MUL=60, DIV=4 -> 24 * 60 / 4 = 360 MHz */
+	val = SUN8I_DPHY_PLL_CTRL_MUL(60) | SUN8I_DPHY_PLL_CTRL_DIV(4);
+	dphy_write(dphy, SUN8I_DPHY_PLL_CTRL, val);
+
+	/* Wait for PLL lock */
+	ret = readl_poll_timeout(dphy->regs + SUN8I_DPHY_STATUS,
+				 val, val & SUN8I_DPHY_STATUS_PLL_LOCK,
+				 1000);
+	if (ret)
+		return ret;
+
+	/* Enable PLL */
+	dphy_write(dphy, SUN8I_DPHY_PLL_CTRL,
+		   dphy_read(dphy, SUN8I_DPHY_PLL_CTRL) | SUN8I_DPHY_PLL_CTRL_ENABLE);
+
+	/* Configure timing for 360 MHz DDR clock */
+	/* These are approximate values for 720 Mbps */
+	dphy_write(dphy, SUN8I_DPHY_TIMING0, 0x000f0302);
+	dphy_write(dphy, SUN8I_DPHY_TIMING1, 0x00120504);
+	dphy_write(dphy, SUN8I_DPHY_TIMING2, 0x00280a08);
+	dphy_write(dphy, SUN8I_DPHY_TIMING3, 0x00501410);
+
+	/* Enable D-PHY with 2 data lanes + clock lane */
+	val = SUN8I_DPHY_CTRL0_ENABLE |
+	      SUN8I_DPHY_CTRL0_LANES(2) |
+	      SUN8I_DPHY_CTRL0_CLK_LANE;
+	dphy_write(dphy, SUN8I_DPHY_CTRL0, val);
+
+	return 0;
+}
+
+static int sun8i_a33_mipi_dphy_exit(struct phy *phy)
+{
+	struct sun8i_a33_mipi_dphy *dphy = dev_get_priv(phy->dev);
+
+	/* Disable D-PHY */
+	dphy_write(dphy, SUN8I_DPHY_CTRL0, 0);
+
+	reset_assert_bulk(&dphy->resets);
+	clk_disable(&dphy->clk);
+
+	return 0;
+}
+
+static int sun8i_a33_mipi_dphy_power_on(struct phy *phy)
+{
+	return sun8i_a33_mipi_dphy_init(phy);
+}
+
+static int sun8i_a33_mipi_dphy_power_off(struct phy *phy)
+{
+	return sun8i_a33_mipi_dphy_exit(phy);
+}
+
+static const struct phy_ops sun8i_a33_mipi_dphy_ops = {
+	.init = sun8i_a33_mipi_dphy_init,
+	.exit = sun8i_a33_mipi_dphy_exit,
+	.power_on = sun8i_a33_mipi_dphy_power_on,
+	.power_off = sun8i_a33_mipi_dphy_power_off,
+};
+
+static int sun8i_a33_mipi_dphy_probe(struct udevice *dev)
+{
+	struct sun8i_a33_mipi_dphy *dphy = dev_get_priv(dev);
+	int ret;
+
+	dphy->regs = (void __iomem *)0x01c24400;
+	dphy->lanes = 2;
+
+	ret = clk_get_by_name(dev, "dphy", &dphy->clk);
+	if (ret)
+		return ret;
+
+	ret = reset_get_bulk(dev, &dphy->resets);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static const struct udevice_id sun8i_a33_mipi_dphy_ids[] = {
+	{ .compatible = "allwinner,sun8i-a33-mipi-dphy" },
+	{ }
+};
+
+U_BOOT_DRIVER(sun8i_a33_mipi_dphy) = {
+	.name = "sun8i_a33_mipi_dphy",
+	.id = UCLASS_PHY,
+	.of_match = sun8i_a33_mipi_dphy_ids,
+	.ops = &sun8i_a33_mipi_dphy_ops,
+	.probe = sun8i_a33_mipi_dphy_probe,
+	.priv_auto = sizeof(struct sun8i_a33_mipi_dphy),
+};